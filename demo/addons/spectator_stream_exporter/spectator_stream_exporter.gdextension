[configuration]

entry_symbol = "spectator_stream_exporter_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.windows.template_release.x86_64.dll"
macos.debug = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.macos.template_debug.framework"
macos.release = "res://addons/spectator_stream_exporter/bin/libspectator_stream_exporter.macos.template_release.framework"
